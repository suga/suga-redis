{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suga-Redis",
  "version": "0.2.0",
  "identifier": "com.sugamele.sugaredis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Suga-Redis",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/suga/suga-redis/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMUI5Q0Q1RjI2RjkzOUMKUldTY2syL3kxWndiNEJCQnJjbzdCM1JRQjhkb1lhWUVtdmNuQ1BjOE1hTC9lRmtqbXNPUVcxSFEK"
    }
  }
}
